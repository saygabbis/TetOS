# === LLM ===
# Provedor principal: ollama (padrão) ou minimax.
TETOS_LLM_PROVIDER=ollama

# Ollama local ou Ollama Cloud.
TETOS_OLLAMA_MODE=local
TETOS_OLLAMA_URL=http://localhost:11434
# TETOS_OLLAMA_CLOUD_URL=https://ollama.com
# TETOS_OLLAMA_API_KEY=
# OLLAMA_API_KEY=

# Modelo padrão: local usa llama3; cloud costuma usar minimax-m2.7:cloud.
TETOS_MODEL=llama3
TETOS_OLLAMA_TEMPERATURE=0.65
# 0 ou unlimited = sem limite artificial.
TETOS_OLLAMA_NUM_PREDICT=400

# MiniMax direto.
# TETOS_MINIMAX_API_KEY=
TETOS_MINIMAX_MODEL=MiniMax-M2.7
TETOS_MINIMAX_WORKER_MODEL=MiniMax-M2.7-highspeed
TETOS_MINIMAX_BASE_URL=https://api.minimax.io

# === API / Memória / Prompt ===
TETOS_PORT=6453
TETOS_MEMORY_PATH=./data/memory.json
TETOS_SHORT_TERM_PATH=./data/short-term
TETOS_MAX_SHORT=24
TETOS_PERSONALITY_PATH=./data/personality.json
TETOS_CHARACTER_PATH=./data/character.json
TETOS_MAX_HISTORY=24
TETOS_MAX_CONTENT=2000
TETOS_MAX_ID=64
TETOS_MAX_TAGS=10
TETOS_RESPONSE_HISTORY=5
TETOS_RESPONSE_SIMILARITY=0.75
# Omita para sem limite; use inteiro >= 1 para limitar bolhas.
# TETOS_RESPONSE_MAX_PARTS=8

# === Persistência de estado ===
TETOS_STATE_PATH=./data/state.json
TETOS_TIME_PATH=./data/time.json
TETOS_USER_PATTERNS_PATH=./data/userPatterns.json
TETOS_SELECTIVE_MEMORY_PATH=./data/selectiveMemory.json
TETOS_CHANNEL_REGISTRY_PATH=./data/channels.json
TETOS_SELECTIVE_MEMORY_CAPACITY=12
TETOS_SELECTIVE_MEMORY_EXPIRATION_MS=21600000
TETOS_SELECTIVE_MEMORY_REINFORCEMENT_THRESHOLD=3
TETOS_MULTIMODAL_MEMORY_PATH=./data/multimodalMemory.json
TETOS_MEMORY_EPISODIC_PATH=./data/episodicMemory.ndjson
TETOS_GROUP_MEMORY_PATH=./data/groupMemory.ndjson
TETOS_GROUP_MEMORY_MAX_ENTRIES=500
TETOS_MEMORY_DECAY_ENABLED=true

# === Busca / Documentos / Observabilidade ===
TETOS_SEARCH_ENABLED=true
TETOS_SEARCH_MAX_RESULTS=5
TETOS_DOCUMENTS_PATH=./data/documents
TETOS_LOG_PATH=./data/logs/tetos.log
TETOS_METRICS_PATH=./data/metrics.json
TETOS_PENDING_CONFIRMATIONS_PATH=./data/pendingConfirmations.json
TETOS_ADMIN_USER_ID=
ADMIN_USER_ID=

# === WhatsApp ===
WHATSAPP_ENABLED=true
# single = um número para chat + mídia.
# dual/multi/split/session-media = sessão principal + sessão de comandos de mídia.
WHATSAPP_MODE=single
WHATSAPP_SESSION_PATH=./data/session
WHATSAPP_MEDIA_SESSION_PATH=./data/session-media
WHATSAPP_MAIN_OBSERVE_ONLY=true
WHATSAPP_AUTO_CONNECT=true
# false costuma manter linked device mais estável.
WHATSAPP_MARK_ONLINE_ON_CONNECT=false
# 0 = watchdog desligado.
WHATSAPP_INBOUND_STALE_MS=0
WHATSAPP_INBOUND_CHECK_MS=30000

REPLY_ENABLED=true
LEARNING_MODE_ENABLED=true
THINKING_LOGS_ENABLED=true
COMMAND_PREFIX=.
COMMAND_MEDIA_HISTORY_LIMIT=30
COMMAND_MEDIA_DERIVED_PATH=./data/media/derived
# Texto opcional no modo dual quando comando de figurinha chega na sessão errada.
# WHATSAPP_STICKER_COMMANDS_DISABLED_HINT=

# Ativação: false = qualquer contato conversa; true = exige /teto-ativar ou /teto-grupo-ativar.
TETOS_ACTIVATION_REQUIRED=false
TETOS_ACTIVATION_PATH=./data/tetoActivations.json

# === WhatsApp / Mídia / Figurinhas ===
TETOS_WHATSAPP_MEDIA_PATH=./data/media
TETOS_MEDIA_RETENTION_ENABLED=true
TETOS_MEDIA_HOT_MAX_MB=100
TETOS_MEDIA_RETENTION_INTERVAL_MS=900000
TETOS_STICKERS_PATH=./data/stickers
TETOS_STICKER_ONLY_CHANCE=0.35
# KiB máximo para figurinha enviada ao WhatsApp.
TETOS_STICKER_MAX_KB=500

# remove.bg: aceita uma ou várias chaves separadas por vírgula ou ponto-e-vírgula.
# REMOVEBG_API_KEY=
# REMOVEBG_API_KEYS=
# TETOS_REMOVEBG_API_KEY=
# TETOS_REMOVEBG_API_KEYS=
TETOS_REMOVEBG_MODEL=small
# TETOS_REMOVEBG_DEBUG=1

# === Reminders ===
TETOS_REMINDERS_PATH=./data/reminders.json
TETOS_REMINDER_SWEEP_MS=60000
TETOS_REMINDER_MAX_DELIVERY_ATTEMPTS=5
TETOS_REMINDER_DELIVERY_RETRY_MS=300000

# === Aprendizado / relatórios ===
LEARNING_TARGET_USER_ID=
TETOS_OWNER_WA_JID=
TETOS_OWNER_WA_JIDS=
THIRD_PARTY_ANONYMIZATION=strong
LEARNING_LEDGER_PATH=./data/learning-ledger
LEARNING_FOCUS_PATH=./data/learningFocus.json
BEHAVIOR_PROFILES_PATH=./data/behaviorProfiles.json
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=00:00
DAILY_REPORT_TZ=America/Sao_Paulo
DAILY_REPORTS_PATH=./data/reports/daily

# === Presença / iniciativa ===
PRESENCE_ENABLED=true
PRESENCE_CHECK_MS=60000
PRESENCE_MIN_COOLDOWN_MS=1800000
PRESENCE_MAX_COOLDOWN_MS=7200000
PRESENCE_MAX_DAILY_PER_USER=3
PRESENCE_INACTIVE_MS=600000
TETOS_INITIATION_CHANCE=0.1
TETOS_INITIATION_QUEUE_PATH=./data/initiationQueue.json

# === Teto Brain / vida ===
TETOS_BRAIN_ENABLED=true
TETOS_LIFE_PATH=./data/tetoLife.json
TETOS_LIFE_STATE_PATH=./data/lifeState.json
TETOS_LIFE_JOURNAL_PATH=./data/lifeJournal.ndjson
TETOS_AUTONOMOUS_STATE_PATH=./data/autonomousState.json
TETOS_EMOTION_STATE_PATH=./data/emotionState.json
TETOS_BODY_NEEDS_PATH=./data/bodyNeeds.json
TETOS_HEALTH_STATE_PATH=./data/healthState.json
TETOS_SOCIAL_GRAPH_PATH=./data/socialGraph.json
TETOS_TRUST_BONDS_PATH=./data/trustBonds.json
TETOS_WORLD_CONTEXT_PATH=./data/worldContext.json
TETOS_MUSIC_STATE_PATH=./data/musicState.json
TETOS_MUSIC_DISCOGRAPHY_PATH=./data/tetoDiscography.json
TETOS_ABSORBED_PATTERNS_PATH=./data/absorbedPatterns.json
TETOS_LIFE_TICK_MS=900000

# Mind log: slim para uso 24/7; full para debug pesado.
TETOS_MIND_LOG_PATH=./data/mind-log
TETOS_MIND_LOG_ENABLED=true
TETOS_MIND_LOG_MODE=slim
TETOS_MIND_LOG_ONLY_REPLIES=true
TETOS_MIND_LOG_RETENTION_DAYS=14

# Timing e geração.
TETOS_TIMING_ENGINE_ENABLED=true
TETOS_BRAIN_BACKGROUND_TICK_MS=120000
TETOS_SOLO_THOUGHT_INTERVAL_MS=300000
TETOS_MUSIC_RESEARCH_INTERVAL_MS=86400000
TETOS_BATCH_WINDOW_MS=1200
TETOS_GROUP_BATCH_WINDOW_MS=2200
TETOS_MAX_PARALLEL_GENERATIONS=3
TETOS_MAX_QUEUE_COALESCE=6
TETOS_GROUP_ENGAGEMENT_MS=120000
TETOS_TYPING_GRACE_MS=2400
TETOS_TYPING_MIN_DELAY_MS=140
TETOS_TYPING_MAX_DELAY_MS=2400
TETOS_MODEL_TIMEOUT_MS=25000

# Mídia e adapters.
TETOS_MEDIA_LEARNING_PATH=./data/mediaLearning.json
TETOS_AUDIO_TRANSCRIPTIONS_PATH=./data/audioTranscriptions.json
TETOS_VISUAL_ANALYSES_PATH=./data/visualAnalyses.json
TETOS_MULTIMODAL_MAX_PER_SCOPE=12
TETOS_VISUAL_MAX_PER_SCOPE=10
# ollama = visão via LLM multimodal (igual Sellye); blip = Python BLIP local.
TETOS_VISION_ADAPTER=ollama
TETOS_VISION_ENABLED=true
# Modelo com visão. Vazio = TETOS_MODEL.
# Local: llava, llama3.2-vision:11b (ollama pull antes de usar).
# Cloud (TETOS_OLLAMA_MODE=cloud): gemma4:31b:cloud ou outro multimodal da cloud — não use llava.
# TETOS_VISION_MODEL=gemma4:31b:cloud
TETOS_VISION_TIMEOUT_MS=60000
TETOS_MEDIA_ENRICH_ENABLED=true
TETOS_VIDEO_ADAPTER=ffmpeg_frames
TETOS_WEB_READER_ENABLED=true
TETOS_WORKER_LLM_URL=
TETOS_WORKER_LLM_MODEL=
