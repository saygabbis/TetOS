# Provedor LLM: ollama (padrão) ou minimax (API direta em platform.minimax.io)
# TETOS_LLM_PROVIDER=ollama
# TETOS_MINIMAX_API_KEY=
# TETOS_MINIMAX_MODEL=MiniMax-M2.7
# TETOS_MINIMAX_WORKER_MODEL=MiniMax-M2.7-highspeed
# TETOS_MINIMAX_BASE_URL=https://api.minimax.io

# Modo do cérebro: local (Ollama na máquina) ou cloud (API em ollama.com)
TETOS_OLLAMA_MODE=local

# Local: URL do daemon Ollama (ignorado quando TETOS_OLLAMA_MODE=cloud)
TETOS_OLLAMA_URL=http://localhost:11434

# Cloud: chave em https://ollama.com/settings/keys (obrigatória se TETOS_OLLAMA_MODE=cloud)
# Também aceita OLLAMA_API_KEY (convenção oficial da Ollama).
# TETOS_OLLAMA_API_KEY=

# Cloud: host da API (padrão https://ollama.com)
# TETOS_OLLAMA_CLOUD_URL=https://ollama.com

# Modelo: no modo local o padrão é llama3; no cloud o padrão é minimax-m2.7:cloud
TETOS_MODEL=llama3
# Criatividade do modelo (0–2). Padrão 0.65 — um pouco mais preso ao que foi pedido; suba se quiser mais solto.
# TETOS_OLLAMA_TEMPERATURE=0.65
# Máximo de tokens gerados por resposta (Ollama). Padrão 400 — costuma deixar o chat mais rápido; 0 ou unlimited = sem limite.
# TETOS_OLLAMA_NUM_PREDICT=400
TETOS_MEMORY_PATH=./data/memory.json
TETOS_MAX_SHORT=24
TETOS_PORT=6453
# Opcional: força o userId no terminal (para compartilhar memória com WhatsApp)
# TETOS_USER_ID=5516988137617
TETOS_PERSONALITY_PATH=./data/personality.json
TETOS_MAX_HISTORY=24
# Janela de agrupamento de mensagens seguidas (ms). DM padrão 1200; grupo 2200.
# TETOS_BATCH_WINDOW_MS=1200
# TETOS_GROUP_BATCH_WINDOW_MS=2200
# Máx. gerações LLM em paralelo (evita timeout sob carga). Padrão 3.
# TETOS_MAX_PARALLEL_GENERATIONS=3
# Quando a fila de uma sessão enche, msgs pendentes viram 1 resposta. Padrão 6.
# TETOS_MAX_QUEUE_COALESCE=6
# Em grupo: após @ ou chamar pelo nome, segue respondendo o mesmo usuário por 2 min (reseta a cada msg).
# TETOS_GROUP_ENGAGEMENT_MS=120000
# Limite de memória de mídia por usuário+grupo (evita JSON gigante).
# TETOS_MULTIMODAL_MAX_PER_SCOPE=12
# TETOS_VISUAL_MAX_PER_SCOPE=10
TETOS_MAX_CONTENT=2000
TETOS_MAX_ID=64
TETOS_MAX_TAGS=10
TETOS_RESPONSE_HISTORY=5
TETOS_RESPONSE_SIMILARITY=0.75
# Opcional: teto de bolhas por resposta. Omita (padrão) = sem limite artificial.
# TETOS_RESPONSE_MAX_PARTS=8
WHATSAPP_ENABLED=true
# single = um número (chat + comandos .sticker/.toimg). dual (ou multi/split) = dois números no mesmo processo:
# sessão principal = aprendizado + respostas; segunda pasta = só comandos de figurinha.
WHATSAPP_MODE=single
# dual | session-media = 2 números: principal aprende (observe), secundário = bot Teto responde
# WHATSAPP_MAIN_OBSERVE_ONLY=true
WHATSAPP_SESSION_PATH=./data/session
WHATSAPP_MEDIA_SESSION_PATH=./data/session-bot
# Opcional no dual: se mandar .sticker no número principal, responde este texto (vazio = só ignora o comando).
# WHATSAPP_STICKER_COMMANDS_DISABLED_HINT=Figurinhas uso no outro número.

WHATSAPP_AUTO_CONNECT=true
# false (padrão) = linked device recebe mensagens com mais estabilidade
# WHATSAPP_MARK_ONLINE_ON_CONNECT=false
# Reconecta bot se ficar 3 min conectada sem nenhum upsert (padrão 180000 ms)
# WHATSAPP_INBOUND_STALE_MS=180000
LEARNING_MODE_ENABLED=true
REPLY_ENABLED=false
THINKING_LOGS_ENABLED=true
COMMAND_PREFIX=.
COMMAND_MEDIA_HISTORY_LIMIT=30
COMMAND_MEDIA_DERIVED_PATH=./data/media/derived
# Retenção de mídia: teto em MB para `data/media` (exceto `_archive`); acima remove LRU; figurinhas em `derived/` saem primeiro.
# Imagens referenciadas em vision/multimodal ganham miniatura em `data/media/_archive/knowledge/` antes de apagar o original.
# TETOS_MEDIA_RETENTION_ENABLED=true
# TETOS_MEDIA_HOT_MAX_MB=100
# Intervalo entre varreduras (ms). Padrão 900000 = 15 min.
# TETOS_MEDIA_RETENTION_INTERVAL_MS=900000
# Limite (KiB) para o ficheiro da figurinha no WhatsApp; a conversão reajusta qualidade/tamanho (padrão 950).
# TETOS_STICKER_MAX_KB=950
# Telefone da dona — admin, relatórios e aprendizado (NÃO vira memória compartilhada)
LEARNING_TARGET_USER_ID=
# JID/LID do seu PV com a Teto (ex.: 157947506229421@lid) — reconhece você como dona
TETOS_OWNER_WA_JID=
THIRD_PARTY_ANONYMIZATION=strong
LEARNING_LEDGER_PATH=./data/learning-ledger
LEARNING_FOCUS_PATH=./data/learningFocus.json
BEHAVIOR_PROFILES_PATH=./data/behaviorProfiles.json
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=00:00
DAILY_REPORT_TZ=America/Sao_Paulo
DAILY_REPORTS_PATH=./data/reports/daily
PRESENCE_ENABLED=true
PRESENCE_CHECK_MS=60000
PRESENCE_MIN_COOLDOWN_MS=1800000
PRESENCE_MAX_COOLDOWN_MS=7200000
PRESENCE_MAX_DAILY_PER_USER=3
PRESENCE_INACTIVE_MS=600000

# === TETO BRAIN ===
TETOS_BRAIN_ENABLED=true
TETOS_LIFE_PATH=./data/tetoLife.json
TETOS_LIFE_STATE_PATH=./data/lifeState.json
TETOS_EMOTION_STATE_PATH=./data/emotionState.json
TETOS_BODY_NEEDS_PATH=./data/bodyNeeds.json
TETOS_HEALTH_STATE_PATH=./data/healthState.json
TETOS_SOCIAL_GRAPH_PATH=./data/socialGraph.json
TETOS_TRUST_BONDS_PATH=./data/trustBonds.json
TETOS_WORLD_CONTEXT_PATH=./data/worldContext.json
TETOS_MUSIC_STATE_PATH=./data/musicState.json
TETOS_MUSIC_DISCOGRAPHY_PATH=./data/tetoDiscography.json
TETOS_ABSORBED_PATTERNS_PATH=./data/absorbedPatterns.json
TETOS_GROUP_MEMORY_PATH=./data/groupMemory.ndjson
TETOS_MIND_LOG_PATH=./data/mind-log
TETOS_MIND_LOG_ENABLED=true
TETOS_LIFE_JOURNAL_PATH=./data/lifeJournal.ndjson
TETOS_TIMING_ENGINE_ENABLED=true
TETOS_BRAIN_BACKGROUND_TICK_MS=120000
TETOS_SOLO_THOUGHT_INTERVAL_MS=300000
TETOS_MUSIC_RESEARCH_INTERVAL_MS=86400000
TETOS_BATCH_WINDOW_MS=650
TETOS_TYPING_GRACE_MS=2400
TETOS_TYPING_MIN_DELAY_MS=140
TETOS_TYPING_MAX_DELAY_MS=2400
TETOS_MODEL_TIMEOUT_MS=25000
TETOS_MEMORY_EPISODIC_PATH=./data/episodicMemory.ndjson
TETOS_GROUP_MEMORY_MAX_ENTRIES=500
TETOS_MEMORY_DECAY_ENABLED=true
TETOS_MEDIA_LEARNING_PATH=./data/mediaLearning.json
TETOS_VISION_ADAPTER=blip
TETOS_VIDEO_ADAPTER=ffmpeg_frames
TETOS_WEB_READER_ENABLED=true
TETOS_MODEL_TIMEOUT_MS=25000
TETOS_WORKER_LLM_URL=https://ollama.com
TETOS_WORKER_LLM_MODEL=minimax-m2.7:cloud
# false = qualquer contato conversa; true = só /teto-ativar e /teto-grupo-ativar
TETOS_ACTIVATION_REQUIRED=true
TETOS_ACTIVATION_PATH=./data/tetoActivations.json
